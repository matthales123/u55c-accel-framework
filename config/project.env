# Generated project defaults
PROJECT_NAME=u55c_accel_framework
U55C_FLOW=both

# U55C target defaults
U55C_PLATFORM=xilinx_u55c_gen3x16_xdma_3_202210_1
U55C_PART=xcu55c-fsvh2892-2L-e
U55C_DEVICE_INDEX=0

# Kernel defaults
U55C_KERNEL_NAME=vector_add
U55C_XCLBIN=build/hardware/hw/vector_add.xclbin
U55C_DASHBOARD_ARTIFACT_DIR=$HOME/.local/share/fpga-dashboard-web/artifacts/xclbin

# Benchmark defaults
U55C_DEFAULT_ELEMENTS=1048576
U55C_DEFAULT_ITERATIONS=10
U55C_SWEEP_SIZES="65536 262144 1048576 4194304"
U55C_SWEEP_ITERATIONS=10
U55C_SWEEP_MODE=dry-run

# Build defaults
U55C_ENABLE_XRT=ON

# Tool settings paths (adjust if your install path differs)
VITIS_SETTINGS=/tools/Xilinx/2025.1/Vitis/settings64.sh
VIVADO_SETTINGS=/tools/Xilinx/2025.1/Vivado/settings64.sh

# Optional Vivado board repo paths (':' separated). Existing directories only
# are used by run_vivado.sh/run_sim.sh/run_synth.sh.
U55C_BOARD_REPO_PATHS=/opt/xilinx/board_files/u55c:$HOME/xilinx_board_files/u55c
